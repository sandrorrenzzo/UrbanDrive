# Padrão de código do UrbanDrive.
# Lido pelo VS Code (C# Dev Kit), pelo Visual Studio e pelo dotnet format/build.

root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,csproj,slnx,props,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]

# Organização do arquivo
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Chaves e quebras de linha (chave sempre em linha própria)
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_prefer_braces = when_multiline:suggestion

# var quando o tipo é óbvio pelo lado direito
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# Propriedades e acessores curtos com =>, métodos e construtores com bloco
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_constructors = false:suggestion

# Preferências da linguagem
dotnet_style_readonly_field = true:warning
dotnet_style_require_accessibility_modifiers = always:warning
csharp_style_prefer_pattern_matching = true:suggestion
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion

# Nomes
# Constantes e campos static readonly: PascalCase (ex.: ValidadeFutura)
dotnet_naming_rule.constantes.symbols = constantes
dotnet_naming_rule.constantes.style = pascal
dotnet_naming_rule.constantes.severity = warning
dotnet_naming_symbols.constantes.applicable_kinds = field
dotnet_naming_symbols.constantes.required_modifiers = static, readonly

dotnet_naming_rule.constantes_const.symbols = constantes_const
dotnet_naming_rule.constantes_const.style = pascal
dotnet_naming_rule.constantes_const.severity = warning
dotnet_naming_symbols.constantes_const.applicable_kinds = field
dotnet_naming_symbols.constantes_const.required_modifiers = const

# Campos privados: _camelCase (ex.: _placa)
dotnet_naming_rule.campos_privados.symbols = campos_privados
dotnet_naming_rule.campos_privados.style = underscore_camel
dotnet_naming_rule.campos_privados.severity = warning
dotnet_naming_symbols.campos_privados.applicable_kinds = field
dotnet_naming_symbols.campos_privados.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

# Interfaces: começam com I (ex.: IImprimivel)
dotnet_naming_rule.interfaces.symbols = interfaces
dotnet_naming_rule.interfaces.style = prefixo_i
dotnet_naming_rule.interfaces.severity = warning
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.prefixo_i.capitalization = pascal_case
dotnet_naming_style.prefixo_i.required_prefix = I

# Classes, propriedades, métodos e enums: PascalCase (ex.: ValorDiaria)
dotnet_naming_rule.tipos_e_membros.symbols = tipos_e_membros
dotnet_naming_rule.tipos_e_membros.style = pascal
dotnet_naming_rule.tipos_e_membros.severity = warning
dotnet_naming_symbols.tipos_e_membros.applicable_kinds = class, struct, enum, property, method, event, delegate
dotnet_naming_style.pascal.capitalization = pascal_case

# Avisos de estilo mais úteis no build (IDE = regras de estilo do .NET)
dotnet_diagnostic.IDE0005.severity = warning   # using não utilizado
dotnet_diagnostic.IDE0044.severity = warning   # campo que poderia ser readonly
dotnet_diagnostic.IDE0161.severity = warning   # namespace em bloco em vez de file-scoped
dotnet_diagnostic.IDE1006.severity = warning   # nome fora do padrão
